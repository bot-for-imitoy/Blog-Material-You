{
  "name": "blog-material-you",
  "version": "2.0.0",
  "private": true,
  "description": "Material You blog — Node.js + TypeScript SSR rewrite with local Markdown storage",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/sync-assets.mjs",
    "passwd-reset": "node scripts/passwd-reset.mjs",
    "postinstall": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@material/material-color-utilities": "^0.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mdui": "^2.1.5",
    "multer": "^2.0.0",
    "sharp": "^0.33.5",
    "ssh2-sftp-client": "^12.0.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
