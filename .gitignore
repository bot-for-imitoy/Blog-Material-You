# Blog Material You — .gitignore

# Dependencies and caches
node_modules/
.npm-cache/

# Vendored front-end libraries (regenerated from node_modules)
blog/public/vendor/

# Runtime state: credentials, comments, visitors, TOTP, settings, sessions
blog/data/

# Content (keep local; the repo ships only the directory placeholders)
blog/posts/*.md
blog/pages/*.md
blog/talks/*.md
blog/friends/*.md

# Uploaded / generated media
blog/public/avatars/
blog/public/uploads/

# Secrets (copy .env.example to .env)
.env

# The working copy of the site config: copied from the tracked master
# `config.yml` on boot and modified at runtime by the admin console.
_config.yml

# Static build output (npm run build)
blog/dist/

# Local deployment files that may contain real credentials
docker-compose.local.yml
certs.local/

# The previous OpenResty implementation's runtime files
backend/logs/
backend/tmp/
backend/data/
backend/nginx.pid
*.pid

# Local scratch files
.scratch_*
project_dump.txt

# OS / editor
.DS_Store
Thumbs.db
