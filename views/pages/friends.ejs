<mdui-card variant="filled" class="header-card">
  <div class="header-title"><%= t('page_friends') %></div>
  <div class="header-content"><%= t('page_friends_desc') %></div>
</mdui-card>

<div class="friends-wrapper">
<% if (!list || list.length === 0) { %>
  <p class="empty-hint"><%= t('noFriends') %></p>
<% } else { %>
  <mdui-list class="posts-list">
  <% list.forEach(function (friend) { %>
    <mdui-list-item href="<%= friend.url %>" target="_blank" rel="noopener noreferrer">
      <% if (friend.avatar) { %>
      <%# Remote avatars pass through unchanged; a locally hosted one is
          downscaled to the size the list actually paints it at. %>
      <img src="<%= mediaUrl(friend.avatar, { width: 96, fit: 'cover' }) %>" alt="<%= friend.title %>" slot="icon" class="friend-avatar" loading="lazy" decoding="async">
      <% } else { %>
      <mdui-icon src="/icon/person.svg" slot="icon"></mdui-icon>
      <% } %>
      <div class="mdui-list-item-content">
        <div class="mdui-list-item-title"><%= friend.titleEn || friend.title %></div>
        <% if (friend.descrEn || friend.descr) { %>
        <div class="mdui-list-item-text"><%= friend.descrEn || friend.descr %></div>
        <% } %>
      </div>
    </mdui-list-item>
  <% }); %>
  </mdui-list>
<% } %>
</div>
