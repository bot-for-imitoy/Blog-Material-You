<mdui-card variant="filled" class="header-card">
  <div class="header-title"><%= t('page_posts') %></div>
  <div class="header-content"><%= t('page_posts_desc') %></div>
</mdui-card>

<% if (!years || years.length === 0) { %>
  <p class="empty-hint"><%= t('no_posts') %></p>
<% } %>
<% (years || []).forEach(function (group) { %>
<h1 class="posts-year"><%= group.year %><%= t('postsYear') %></h1>
<mdui-list class="posts-list">
  <% group.posts.forEach(function (post) { %>
  <mdui-list-item href="/post/<%= urlEncode(post.slug) %>">
    <div class="mdui-list-item-content">
      <div class="mdui-list-item-title"><%= post.title %></div>
      <div class="mdui-list-item-text"><%= formatDate(post.date) %></div>
    </div>
  </mdui-list-item>
  <% }); %>
</mdui-list>
<% }); %>
