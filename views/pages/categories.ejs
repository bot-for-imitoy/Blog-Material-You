<mdui-card variant="filled" class="header-card">
  <div class="header-title"><%= t('page_categories') %></div>
  <div class="header-content"><%= t('page_categories_desc') %></div>
</mdui-card>

<div class="tags-container">
<% if (!cats || cats.length === 0) { %>
  <p class="empty-hint"><%= t('no_posts') %></p>
<% } %>
<% (cats || []).forEach(function (cat) { %>
  <mdui-chip rounded href="/categories/<%= urlEncode(cat.name) %>/">
    <mdui-icon src="/icon/category.svg" slot="icon"></mdui-icon>
    <%= cat.name %>
    <span slot="badge"><%= cat.count %></span>
  </mdui-chip>
<% }); %>
</div>
