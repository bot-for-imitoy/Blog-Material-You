<%
  /**
   * Inline icon set. Icons are SVG paths drawn with `currentColor`, so they
   * inherit the button's colour and need no extra network request (and no icon
   * font, which the strict CSP would block anyway).
   */
  const ICONS = {
    // "<>" developer glyph
    github: '<path d="M9 7 4 12l5 5M15 7l5 5-5 5"/>',
    // document / article
    blog: '<path d="M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v6h6"/><path d="M9 13h7M9 17h5"/>',
    // branch / node
    more: '<circle cx="6.5" cy="6" r="2.5"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="12" r="2.5"/><path d="M6.5 8.5v7M8.8 6.2h3.7a2.8 2.8 0 0 1 2.8 2.8v1.1"/>',
    // music note
    music: '<path d="M9 17.5V6.2l10-2v11.3"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="15.5" r="2.5"/>',
    // generic link / globe
    link: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.2 2.4 3.3 5.3 3.3 8.5S14.2 18.1 12 20.5c-2.2-2.4-3.3-5.3-3.3-8.5S9.8 5.9 12 3.5z"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
    rss: '<path d="M5 18.5h.01"/><path d="M5 12.5a6 6 0 0 1 6 6"/><path d="M5 6.5a12 12 0 0 1 12 12"/>',
  };
  const CHEVRON_RIGHT = '<path d="M9 6l6 6-6 6"/>';
  const CHEVRON_DOWN = '<path d="M6 9.5l6 6 6-6"/>';
  const PLAY_TRIANGLE = '<path d="M8 5.5v13l10.5-6.5z"/>';

  function iconSvg(key, extraClass) {
    const path = ICONS[key] || ICONS.link;
    return '<svg class="pf-icon' + (extraClass ? ' ' + extraClass : '') +
      '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + path + '</svg>';
  }

  const buttons = (profile.buttons || []);
%>
<!--
  Standalone personal card. Rendered through views/layouts/blank.ejs, so it does
  not inherit the site shell — the background can therefore own the whole
  viewport, which is what makes the glassmorphism read correctly.
-->
<div class="pf-scene">
  <!-- Background: either a configured photo (blurred here) or the built-in
       night gradient; the blurred colour blobs behind it add depth either way. -->
  <% if (profile.background) { %>
  <div class="pf-bg pf-bg-image" style="background-image:url('<%= profile.background %>')" aria-hidden="true"></div>
  <% } else { %>
  <div class="pf-bg pf-bg-gradient" aria-hidden="true"></div>
  <% } %>
  <div class="pf-glow" aria-hidden="true"></div>

  <!-- Faint drifting lights ("fireflies"). Purely decorative and animation-only,
       so they cost nothing on the main thread. -->
  <div class="pf-fireflies" aria-hidden="true">
    <% for (let i = 0; i < 16; i += 1) { %>
    <span></span>
    <% } %>
  </div>

  <main class="pf-card">
    <!-- ===== Left: identity ===== -->
    <section class="pf-left">
      <div class="pf-avatar-ring">
        <%# Painted at 132px, so 320 keeps it crisp on a 2x screen. A remote
            avatar passes through `mediaUrl` untouched. %>
        <img class="pf-avatar" src="<%= mediaUrl(profile.avatar || site.avatar, { width: 320, height: 320, fit: 'cover' }) %>" alt="<%= profile.name %>" width="144" height="144" decoding="async">
      </div>

      <p class="pf-greeting"><%= profile.greeting %></p>

      <h1 class="pf-name">
        <span class="pf-name-text"><%= profile.name %></span>
        <span class="pf-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><%- PLAY_TRIANGLE %></svg>
        </span>
      </h1>

      <% if (profile.tagline) { %>
      <p class="pf-tagline"><%= profile.tagline %></p>
      <% } %>

      <% (profile.tags || []).forEach(function (row) { %>
      <ul class="pf-tags">
        <% row.forEach(function (tag) { %>
        <li class="pf-tag"><%= tag %></li>
        <% }); %>
      </ul>
      <% }); %>
    </section>

    <!-- ===== Right: navigation bars ===== -->
    <section class="pf-right">
      <nav class="pf-nav" aria-label="导航">
        <% buttons.forEach(function (button) { %>
          <% if (button.action === 'expand') { %>
          <!-- <details> gives the expand/collapse behaviour with no JavaScript at
               all, and `name` makes the panels mutually exclusive (native
               accordion) where supported — older browsers simply allow several
               panels open at once. -->
          <details class="pf-btn pf-expand<%= button.music ? ' pf-music' : '' %>" name="pf-nav">
            <summary class="pf-btn-face">
              <span class="pf-btn-icon"><%- iconSvg(button.icon) %></span>
              <span class="pf-btn-text"><%= button.text %></span>
              <svg class="pf-icon pf-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- CHEVRON_DOWN %></svg>
            </summary>

            <% if (button.music) { %>
            <div class="pf-panel pf-panel-music">
              <% if (profile.music.embed) { %>
              <iframe
                class="pf-music-embed"
                src="<%= profile.music.embed %>"
                frameborder="0"
                allow="autoplay"
                loading="lazy"
                title="<%= profile.music.title || 'Music' %>"
              ></iframe>
              <% } else if (profile.music.audio) { %>
              <div class="pf-music-meta">
                <% if (profile.music.cover) { %>
                <img class="pf-music-cover" src="<%= mediaUrl(profile.music.cover, { width: 160, height: 160, fit: 'cover' }) %>" alt="" width="56" height="56" loading="lazy" decoding="async">
                <% } %>
                <div class="pf-music-text">
                  <span class="pf-music-title"><%= profile.music.title || '未命名' %></span>
                  <% if (profile.music.artist) { %>
                  <span class="pf-music-artist"><%= profile.music.artist %></span>
                  <% } %>
                </div>
              </div>
              <audio class="pf-audio" src="<%= profile.music.audio %>" controls preload="none"></audio>
              <% } else { %>
              <p class="pf-music-empty">还没有配置音乐。在 <code>_config.yml</code> 的 <code>profile.music.audio</code>（音频直链）或 <code>profile.music.embed</code>（网易云等外链播放器）里填上即可。</p>
              <% } %>
            </div>
            <% } else if (button.items.length > 0) { %>
            <div class="pf-panel">
              <ul class="pf-sublist">
                <% button.items.forEach(function (item) { %>
                <li>
                  <a class="pf-sublink" href="<%= item.href %>">
                    <span><%= item.text %></span>
                    <svg class="pf-icon pf-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- CHEVRON_RIGHT %></svg>
                  </a>
                </li>
                <% }); %>
              </ul>
            </div>
            <% } %>
          </details>
          <% } else { %>
          <a class="pf-btn pf-link" href="<%= button.href %>"<% if (/^https?:/i.test(button.href)) { %> target="_blank" rel="noopener noreferrer"<% } %>>
            <span class="pf-btn-icon"><%- iconSvg(button.icon) %></span>
            <span class="pf-btn-text"><%= button.text %></span>
            <svg class="pf-icon pf-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- CHEVRON_RIGHT %></svg>
          </a>
          <% } %>
        <% }); %>
      </nav>
    </section>
  </main>
</div>
