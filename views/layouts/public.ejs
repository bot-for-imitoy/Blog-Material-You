<!doctype html>
<html lang="<%= site.language %>" class="mdui-theme-auto <%= colorScheme.className %>" data-theme-color="<%= colorScheme.seed %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.desc %>">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.desc %>">
  <meta property="og:type" content="website">
  <% if (site.themeColor) { %>
  <!-- Colours the browser UI (mobile address bar, PWA splash) to match the
       site's Material You seed colour. -->
  <meta name="theme-color" content="<%= site.themeColor %>">
  <% } %>
  <% if (site.keywords && site.keywords.length > 0) { %>
  <meta name="keywords" content="<%= site.keywords.join(', ') %>">
  <% } %>
  <% if (site.author) { %>
  <meta name="author" content="<%= site.author %>">
  <meta property="og:site_name" content="<%= site.title %>">
  <% } %>
  <link rel="canonical" href="<%= seo.canonicalUrl %>">
  <% if (features.rss) { %>
  <link rel="alternate" type="application/rss+xml" title="<%= site.title %>" href="/rss.xml">
  <% } %>

  <!-- mdui 2 (Material Design 3 Web Components) is vendored from npm, so the
       site never depends on a public CDN and the CSP can stay strict. -->
  <link rel="stylesheet" href="/vendor/mdui/mdui.css">

  <!-- The Material You palette, generated from `theme.color` at request time.
       mdui's own `setColorScheme()` would do this in the browser, but doing it
       here means the right colours are in the first paint (no flash of the
       default purple), it still works with JavaScript disabled, and the seed is
       validated on the server instead of silently failing in the browser. -->
  <style><%- colorScheme.css %></style>

  <script src="/vendor/mdui/mdui.global.js"></script>

  <link rel="stylesheet" href="/css/root.css">
  <link rel="stylesheet" href="/css/content-container.css">
  <link rel="stylesheet" href="/css/navigation-drawer.css">
  <link rel="stylesheet" href="/css/lists.css">
  <link rel="stylesheet" href="/css/header-card.css">
  <!-- Loading indicator + content transition for seamless navigation. Shared by
       every page, so it never churns during a pjax swap. -->
  <link rel="stylesheet" href="/css/pjax.css">
  <% (styles || []).forEach(function (entry) { %>
    <% if (typeof entry === 'string') { %>
  <link rel="stylesheet" href="<%= entry %>">
    <% } else { %>
  <link rel="stylesheet" href="<%= entry.href %>"<% if (entry.media) { %> media="<%= entry.media %>"<% } %>>
    <% } %>
  <% }); %>
  <%- headExtra || '' %>
</head>
<body<% if (bodyClass) { %> class="<%= bodyClass %>"<% } %>>
  <!-- Revealed only while a pjax navigation is in flight (pjax.js sets
       data-pjax-loading on <html>); inert and invisible otherwise. -->
  <div class="pjax-progress" aria-hidden="true"></div>

  <mdui-layout class="root">
    <mdui-top-app-bar class="top-app-bar" scroll-behavior="elevate" scroll-target=".content-container">
      <mdui-button-icon class="navigation-drawer-button" variant="text" data-action="toggle-drawer">
        <mdui-icon src="/icon/menu.svg"></mdui-icon>
      </mdui-button-icon>
      <mdui-top-app-bar-title id="app-bar-title"><%= site.title %></mdui-top-app-bar-title>
      <div style="flex-grow: 1"></div>
      <% if (features.search) { %>
      <mdui-button-icon href="/search/" aria-label="<%= t('search_title') %>">
        <mdui-icon src="/icon/search.svg"></mdui-icon>
      </mdui-button-icon>
      <% } %>
    </mdui-top-app-bar>

    <mdui-navigation-drawer class="navigation-drawer" close-on-overlay-click open="true">
      <div class="navigation-drawer-container">
        <div class="navigation-drawer-header">
          <%# Rendered at 64px (navigation-drawer.css), so 160 covers a 2x screen
              without ever sending the 445 kB original. %>
          <mdui-avatar src="<%= mediaUrl(site.avatar || '/img/avatar.svg', { width: 160, fit: 'cover' }) %>" class="navigation-drawer-avatar" id="nav-avatar"></mdui-avatar>
          <div class="navigation-drawer-header-title" id="nav-name"><%= site.title %></div>
          <div class="navigation-drawer-header-subtitle" id="nav-slogan"><%= site.subtitle %></div>
        </div>
        <mdui-list class="navigation-drawer-list" id="sidebar-list">
          <% (menu || []).forEach(function (item) { %>
          <mdui-list-item rounded href="<%= item.route %>" data-route="<%= item.route %>"<% if (isActiveNav(item.route, currentPath)) { %> active<% } %>>
            <%= item.text %>
            <mdui-icon src="<%= item.icon %>" slot="icon"></mdui-icon>
          </mdui-list-item>
          <% }); %>
        </mdui-list>
      </div>
    </mdui-navigation-drawer>

    <mdui-layout-main class="layout-main">
      <!-- The only region a pjax navigation replaces. `data-pjax-scripts` tells
           pjax.js which page modules to tear down and re-initialise for this
           page; the JSON is HTML-escaped here and decoded by the browser when
           the attribute is read. -->
      <div class="content-container" id="content-container" data-pjax-scripts="<%= JSON.stringify(pageScripts || []) %>">
        <%- body %>
      </div>
    </mdui-layout-main>
  </mdui-layout>

  <script src="/js/navigation-drawer.js"></script>
  <script type="module" src="/js/app.js"></script>
  <script type="module" src="/js/pjax.js"></script>
  <% (pageScripts || []).forEach(function (src) { %>
  <script type="module" src="<%= src %>"></script>
  <% }); %>
</body>
</html>
