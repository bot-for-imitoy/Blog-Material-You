<%
  /**
   * admin/dashboard.ejs — overview: stat cards + the five newest posts.
   * `stats` and `recentPosts` come from the dashboard route.
   */
%>
<div class="page-header">
  <h1>📊 控制台</h1>
</div>

<div class="card-grid">
  <div class="stat-card">
    <div class="stat-number"><%= stats.posts %></div>
    <div class="stat-label">已发布文章</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.archived %></div>
    <div class="stat-label">归档文章</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.comments %></div>
    <div class="stat-label">评论</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.talks %></div>
    <div class="stat-label">动态</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.tags %></div>
    <div class="stat-label">标签</div>
  </div>
</div>

<section class="card">
  <h2 class="section-title">最近文章</h2>
  <% if (recentPosts.length === 0) { %>
    <p class="empty-state">暂无文章，点击“新建文章”开始吧</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>标题</th>
            <th>日期</th>
            <th>标识</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% recentPosts.forEach((post) => { %>
            <tr data-slug="<%= post.slug %>">
              <td>
                <%= post.title || post.slug %>
                <% if (post.archived) { %><span class="badge badge-archived">📦 已归档</span><% } %>
              </td>
              <td><%= post.date %></td>
              <td><code><%= post.slug %></code></td>
              <td class="col-actions">
                <a
                  class="btn btn-outline"
                  href="/admin/posts/<%= encodeURIComponent(post.slug) %>/edit/"
                  data-action="edit-post"
                  data-slug="<%= post.slug %>"
                >✏️ 编辑</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
