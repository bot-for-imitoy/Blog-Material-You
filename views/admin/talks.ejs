<%
  /**
   * admin/talks.ejs — short "moments" list, newest first.
   * The list is server-rendered; /js/admin.js only handles delete.
   */
%>
<div class="page-header">
  <h1>💭 动态</h1>
  <a class="btn btn-primary" href="/admin/talks/new/" data-action="new-talk">✏️ 发动态</a>
</div>

<% if (talks.length === 0) { %>
  <p class="empty-state">暂无动态，点击右上角按钮发布第一条</p>
<% } else { %>
  <section class="card">
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>内容</th>
            <th>时间</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% talks.forEach((talk) => { %>
            <tr data-id="<%= talk.id %>">
              <td class="talk-content"><%= talk.content %></td>
              <td class="muted"><%= formatDateTime(talk.createTime) %></td>
              <td class="col-actions">
                <button type="button" class="btn btn-danger" data-action="delete-talk" data-id="<%= talk.id %>">🗑️ 删除</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
