<%
  /**
   * admin/friends.ejs — friend links in display order (sort_order, then id).
   */
%>
<div class="page-header">
  <h1>🔗 友链</h1>
  <a class="btn btn-primary" href="/admin/friends/new/" data-action="new-friend">➕ 添加</a>
</div>

<% if (friends.length === 0) { %>
  <p class="empty-state">暂无友链，点击右上角按钮添加</p>
<% } else { %>
  <section class="card">
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>名称</th>
            <th>链接</th>
            <th>描述</th>
            <th>排序</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% friends.forEach((friend) => { %>
            <tr data-id="<%= friend.id %>">
              <td>
                <% if (friend.avatar) { %>
                  <img class="friend-avatar" src="<%= friend.avatar %>" alt="" width="32" height="32" loading="lazy">
                <% } %>
                <%= friend.title || friend.url %>
              </td>
              <td>
                <a href="<%= friend.url %>" target="_blank" rel="noopener noreferrer"><%= friend.url %></a>
              </td>
              <td class="muted"><%= friend.descr %></td>
              <td><%= friend.sortOrder %></td>
              <td class="col-actions">
                <a
                  class="btn btn-outline"
                  href="/admin/friends/<%= friend.id %>/edit/"
                  data-action="edit-friend"
                  data-id="<%= friend.id %>"
                >✏️ 编辑</a>
                <button
                  type="button"
                  class="btn btn-danger"
                  data-action="delete-friend"
                  data-id="<%= friend.id %>"
                  data-title="<%= friend.title %>"
                >🗑️ 删除</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
