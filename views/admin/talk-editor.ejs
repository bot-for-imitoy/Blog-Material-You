<%
  /**
   * admin/talk-editor.ejs — publish a new moment.
   * Talks are immutable in the UI (only create/delete), matching the original.
   */
%>
<div class="page-header">
  <h1>✏️ 发布动态</h1>
  <div class="page-header-actions">
    <mdui-button variant="text" href="/admin/talks/">取消</mdui-button>
    <mdui-button variant="filled" data-action="save-talk">📤 发布</mdui-button>
  </div>
</div>

<div id="talk-error" class="form-error" hidden></div>

<mdui-card class="card">
  <mdui-text-field
    id="talk-content"
    label="内容"
    rows="6"
    variant="outlined"
    placeholder="写点什么呢..."
  ></mdui-text-field>
</mdui-card>
