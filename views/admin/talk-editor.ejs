<%
  /**
   * admin/talk-editor.ejs — publish a new moment.
   * Talks are immutable in the UI (only create/delete), matching the original.
   */
%>
<div class="page-header">
  <h1>✏️ 发布动态</h1>
  <div class="page-header-actions">
    <a class="btn btn-outline" href="/admin/talks/">取消</a>
  </div>
</div>

<div id="talk-error" class="form-error" role="alert" hidden></div>

<form id="talk-form">
  <section class="card">
    <div class="form-group">
      <label for="talk-content">内容</label>
      <textarea id="talk-content" name="content" rows="6" placeholder="写点什么呢..."></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="save-talk">📤 发布</button>
    </div>
  </section>
</form>
