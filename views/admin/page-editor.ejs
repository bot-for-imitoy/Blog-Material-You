<%
  /**
   * admin/page-editor.ejs — page editor (中文 + English bodies).
   * Same field ids as the post editor for consistency; `page` is never null.
   * `notFound` is optional, so it is normalised rather than tested directly.
   */
  const missing = typeof notFound === 'undefined' ? '' : notFound;
%>
<div class="page-header">
  <h1><%= isNew ? '✏️ 新建页面' : '✏️ 编辑页面' %></h1>
  <div class="page-header-actions">
    <mdui-button variant="text" href="/admin/pages/">取消</mdui-button>
    <mdui-button variant="filled" data-action="save-page">💾 保存</mdui-button>
    <% if (!isNew) { %>
      <mdui-button variant="text" data-action="delete-page" data-slug="<%= page.slug %>">🗑️ 删除</mdui-button>
    <% } %>
  </div>
</div>

<% if (missing) { %>
  <div class="form-warning">页面未找到：<%= missing %></div>
<% } %>
<div id="page-error" class="form-error" hidden></div>

<mdui-card class="card">
  <div class="form-row">
    <mdui-text-field
      id="ed-slug"
      label="标识（Slug）"
      placeholder="about"
      value="<%= page.slug %>"
      helper="仅限字母、数字、点、下划线或短横线"
    ></mdui-text-field>
    <mdui-text-field id="ed-title" label="标题 (中文)" value="<%= page.title %>"></mdui-text-field>
    <mdui-text-field id="ed-title-en" label="标题 (English)" value="<%= page.titleEn %>"></mdui-text-field>
  </div>
</mdui-card>

<mdui-card class="card">
  <h2>内容 (中文)</h2>
  <mdui-text-field
    id="ed-content"
    label="内容 (中文)"
    rows="16"
    variant="outlined"
    placeholder="使用 Markdown 编写内容..."
    value="<%= page.content %>"
  ></mdui-text-field>
</mdui-card>

<mdui-card class="card">
  <h2>内容 (English)</h2>
  <mdui-text-field
    id="ed-content-en"
    label="Content (English)"
    rows="16"
    variant="outlined"
    placeholder="English content in Markdown..."
    value="<%= page.contentEn %>"
  ></mdui-text-field>
</mdui-card>
