<%
  /**
   * admin/page-editor.ejs — page editor (中文 + English bodies).
   * Same field ids as the post editor for consistency; `page` is never null.
   * `notFound` is optional, so it is normalised rather than tested directly.
   */
  const missing = typeof notFound === 'undefined' ? '' : notFound;
%>
<div class="page-header">
  <h1><%= isNew ? '✏️ 新建页面' : '✏️ 编辑页面' %></h1>
  <div class="page-header-actions">
    <a class="btn btn-outline" href="/admin/pages/">取消</a>
    <% if (!isNew) { %>
      <button type="button" class="btn btn-danger" data-action="delete-page" data-slug="<%= page.slug %>">🗑️ 删除</button>
    <% } %>
  </div>
</div>

<% if (missing) { %>
  <div class="form-warning">页面未找到：<%= missing %></div>
<% } %>
<div id="page-error" class="form-error" role="alert" hidden></div>

<form id="page-form">
  <section class="card">
    <div class="form-row">
      <div class="form-group">
        <label for="ed-slug">标识（Slug）</label>
        <input type="text" id="ed-slug" name="slug" placeholder="about" value="<%= page.slug %>">
        <p class="field-help">仅限字母、数字、点、下划线或短横线</p>
      </div>
      <div class="form-group">
        <label for="ed-title">标题 (中文)</label>
        <input type="text" id="ed-title" name="title" value="<%= page.title %>">
      </div>
      <div class="form-group">
        <label for="ed-title-en">标题 (English)</label>
        <input type="text" id="ed-title-en" name="titleEn" value="<%= page.titleEn %>">
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="save-page">💾 保存</button>
    </div>
  </section>

  <section class="card">
    <h2>内容 (中文)</h2>
    <div class="form-group">
      <label for="ed-content">内容 (中文)</label>
      <textarea id="ed-content" name="content" rows="16" placeholder="使用 Markdown 编写内容..."><%= page.content %></textarea>
    </div>
  </section>

  <section class="card">
    <h2>内容 (English)</h2>
    <div class="form-group">
      <label for="ed-content-en">Content (English)</label>
      <textarea id="ed-content-en" name="contentEn" rows="16" placeholder="English content in Markdown..."><%= page.contentEn %></textarea>
    </div>
  </section>
</form>
