<%
  /**
   * admin/editor.ejs — bilingual post editor (plain semantic HTML).
   *
   * `post` is always an object (a draft is supplied for /posts/new/) so the
   * template needs no null checks. Field values go through the escaped output
   * tag, which HTML-escapes them — safe inside attribute values.
   *
   * The Markdown toolbar buttons carry data-action plus data-wrap/data-snippet
   * so /js/admin.js can implement insertion without any inline handler. They
   * are `type="button"` on purpose: a bare <button> inside a <form> would
   * submit it.
   *
   * `notFound` is optional: routes only pass it when the requested file is
   * missing, so it is normalised here instead of being tested directly.
   */
  const missing = typeof notFound === 'undefined' ? '' : notFound;
%>
<div class="page-header">
  <h1><%= isNew ? '✏️ 新建文章' : '✏️ 编辑文章' %></h1>
  <div class="page-header-actions">
    <a class="btn btn-outline" href="/admin/posts/">取消</a>
  </div>
</div>

<% if (missing) { %>
  <div class="form-warning">文章未找到：<%= missing %>（保存将创建一篇新文章）</div>
<% } %>
<div id="editor-error" class="form-error" role="alert" hidden></div>

<form id="post-form">
  <section class="card">
    <div class="form-row">
      <div class="form-group">
        <label for="ed-slug">标识（Slug）</label>
        <input
          type="text"
          id="ed-slug"
          name="slug"
          placeholder="article-slug"
          value="<%= post.slug %>"
          <%= isNew ? '' : 'readonly' %>
        >
        <p class="field-help">仅限字母、数字、点、下划线或短横线</p>
      </div>
      <div class="form-group">
        <label for="ed-date">日期</label>
        <input type="date" id="ed-date" name="date" value="<%= post.date %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="ed-title">标题 (中文)</label>
        <input type="text" id="ed-title" name="title" placeholder="文章标题" value="<%= post.title %>">
      </div>
      <div class="form-group">
        <label for="ed-title-en">标题 (English)</label>
        <input type="text" id="ed-title-en" name="titleEn" placeholder="Post title" value="<%= post.titleEn %>">
      </div>
    </div>

    <div class="form-group">
      <label for="ed-cover">封面图</label>
      <input type="text" id="ed-cover" name="cover" placeholder="https://..." value="<%= post.cover %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="ed-tags">标签 (逗号分隔)</label>
        <input type="text" id="ed-tags" name="tags" placeholder="tag1, tag2" value="<%= post.tags.join(', ') %>">
      </div>
      <div class="form-group">
        <label for="ed-cats">分类 (逗号分隔)</label>
        <input type="text" id="ed-cats" name="categories" placeholder="cat1, cat2" value="<%= post.categories.join(', ') %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="ed-tags-en">标签 (EN)</label>
        <input type="text" id="ed-tags-en" name="tagsEn" placeholder="tag1, tag2">
      </div>
      <div class="form-group">
        <label for="ed-cats-en">分类 (EN)</label>
        <input type="text" id="ed-cats-en" name="categoriesEn" placeholder="cat1, cat2">
      </div>
    </div>

    <div class="form-group form-check">
      <input type="checkbox" id="ed-archived" name="archived" <%= post.archived ? 'checked' : '' %>>
      <label for="ed-archived">归档（不在列表中展示）</label>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="save-post">💾 保存</button>
    </div>
  </section>

  <section class="card">
    <h2>内容 (中文)</h2>
    <div class="md-toolbar">
      <button type="button" id="tb-bold" class="btn btn-outline" title="加粗" data-action="md-bold" data-wrap="**" data-snippet="**加粗**">𝐁</button>
      <button type="button" id="tb-italic" class="btn btn-outline" title="斜体" data-action="md-italic" data-wrap="*" data-snippet="*斜体*">𝑰</button>
      <button type="button" id="tb-heading" class="btn btn-outline" title="标题" data-action="md-heading" data-snippet="&#10;## 标题&#10;">H</button>
      <button type="button" id="tb-list" class="btn btn-outline" title="列表" data-action="md-list" data-snippet="&#10;- 列表项&#10;">≡</button>
      <button type="button" id="tb-code" class="btn btn-outline" title="代码" data-action="md-code" data-snippet="&#10;```&#10;代码&#10;```&#10;">&lt;/&gt;</button>
      <button type="button" id="tb-quote" class="btn btn-outline" title="引用" data-action="md-quote" data-snippet="&#10;&gt; 引用&#10;">❝</button>
    </div>
    <div class="form-group">
      <label for="ed-content">内容 (中文)</label>
      <textarea id="ed-content" name="content" rows="18" placeholder="使用 Markdown 编写内容..."><%= post.content %></textarea>
    </div>
  </section>

  <section class="card">
    <h2>内容 (English)</h2>
    <div class="form-group">
      <label for="ed-content-en">Content (English)</label>
      <textarea id="ed-content-en" name="contentEn" rows="12" placeholder="English content in Markdown..."><%= post.contentEn %></textarea>
    </div>
  </section>
</form>
