<%
  /**
   * admin/visitors.ejs — visitor permissions + the pending approval queue.
   *
   * This page did not exist in the original: approvals used to require manual
   * SQL edits. Permissions are checkboxes so the UI never drifts from
   * `PERMISSIONS` (imported from the store).
   *
   * Wiring for /js/admin.js:
   *   #visitor-perms      checkboxes for the "add/update visitor" form
   *   .pending-perm       per-row checkboxes used when approving that email
   *   data-action         save-visitor / delete-visitor / approve-visitor / reject-visitor
   */
  const permLabel = { calendar: '日历' };
  const labelOf = (perm) => permLabel[perm] || perm;
%>
<div class="page-header">
  <h1>👥 访客</h1>
</div>

<section class="card">
  <h2>添加 / 更新访客</h2>
  <p class="desc">为指定邮箱授予权限；已存在的邮箱会被更新。</p>
  <div id="visitor-error" class="form-error" role="alert" hidden></div>
  <form id="visitor-form">
    <div class="form-row">
      <div class="form-group">
        <label for="visitor-email">邮箱</label>
        <input type="email" id="visitor-email" name="email" placeholder="visitor@example.com">
      </div>
      <div class="form-group">
        <label for="visitor-name">名称（可选）</label>
        <input type="text" id="visitor-name" name="name" placeholder="昵称">
      </div>
    </div>
    <div class="form-group">
      <span class="field-label">权限</span>
      <div id="visitor-perms" class="perm-group">
        <% permissions.forEach((perm) => { %>
          <label class="check-inline">
            <input type="checkbox" name="permissions" value="<%= perm %>">
            <span><%= labelOf(perm) %></span>
          </label>
        <% }); %>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="save-visitor">💾 保存访客</button>
    </div>
  </form>
</section>

<section class="card">
  <h2>已通过验证的访客</h2>
  <% if (visitors.length === 0) { %>
    <p class="empty-state">暂无已注册访客</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>名称</th>
            <th>邮箱</th>
            <th>权限</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% visitors.forEach((visitor) => { %>
            <tr data-email="<%= visitor.email %>">
              <td><%= visitor.name || visitor.email %></td>
              <td><%= visitor.email %></td>
              <td class="muted">
                <% if (visitor.permissions.length === 0) { %>
                  无
                <% } else { %>
                  <%= visitor.permissions.map(labelOf).join('、') %>
                <% } %>
              </td>
              <td class="col-actions">
                <button
                  type="button"
                  class="btn btn-danger"
                  data-action="delete-visitor"
                  data-email="<%= visitor.email %>"
                >🗑️ 删除</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>待审核申请</h2>
  <% if (pending.length === 0) { %>
    <p class="empty-state">暂无待审核的申请</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>名称</th>
            <th>邮箱 / 时间</th>
            <th>权限</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% pending.forEach((item) => { %>
            <tr data-email="<%= item.email %>">
              <td><%= item.name || item.email %></td>
              <td class="muted"><%= item.email %> · <%= formatDateTime(item.createdAt) %></td>
              <td>
                <div class="perm-group">
                  <% permissions.forEach((perm) => { %>
                    <label class="check-inline">
                      <input
                        type="checkbox"
                        class="pending-perm"
                        data-email="<%= item.email %>"
                        value="<%= perm %>"
                      >
                      <span><%= labelOf(perm) %></span>
                    </label>
                  <% }); %>
                </div>
              </td>
              <td class="col-actions">
                <button
                  type="button"
                  class="btn btn-primary"
                  data-action="approve-visitor"
                  data-email="<%= item.email %>"
                >✅ 通过</button>
                <button
                  type="button"
                  class="btn btn-outline"
                  data-action="reject-visitor"
                  data-email="<%= item.email %>"
                >🚫 拒绝</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
