<%
  /**
   * admin/visitors.ejs — visitor permissions + the pending approval queue.
   *
   * This page did not exist in the original: approvals used to require manual
   * SQL edits. Permissions are checkboxes so the UI never drifts from
   * `PERMISSIONS` (imported from the store).
   *
   * Wiring for /js/admin.js:
   *   #visitor-perms      checkboxes for the "add/update visitor" form
   *   .pending-perm       per-row checkboxes used when approving that email
   *   data-action         save-visitor / delete-visitor / approve-visitor / reject-visitor
   */
  const permLabel = { calendar: '日历' };
  const labelOf = (perm) => permLabel[perm] || perm;
%>
<div class="page-header">
  <h1>👥 访客</h1>
</div>

<mdui-card class="card">
  <h2>添加 / 更新访客</h2>
  <p class="desc">为指定邮箱授予权限；已存在的邮箱会被更新。</p>
  <div class="form-row">
    <mdui-text-field id="visitor-email" label="邮箱" type="email" placeholder="visitor@example.com"></mdui-text-field>
    <mdui-text-field id="visitor-name" label="名称（可选）" placeholder="昵称"></mdui-text-field>
  </div>
  <div class="form-group">
    <label>权限</label>
    <div id="visitor-perms" class="perm-group">
      <% permissions.forEach((perm) => { %>
        <mdui-checkbox value="<%= perm %>"><%= labelOf(perm) %></mdui-checkbox>
      <% }); %>
    </div>
  </div>
  <div class="form-actions">
    <mdui-button variant="filled" data-action="save-visitor">💾 保存访客</mdui-button>
  </div>
</mdui-card>

<mdui-card class="card">
  <h2>已通过验证的访客</h2>
  <% if (visitors.length === 0) { %>
    <div class="empty-state">暂无已注册访客</div>
  <% } else { %>
    <% visitors.forEach((visitor) => { %>
      <div class="post-item" data-email="<%= visitor.email %>">
        <div class="post-info">
          <h3><%= visitor.name || visitor.email %></h3>
          <span>
            <%= visitor.email %>
            · 权限：
            <% if (visitor.permissions.length === 0) { %>
              无
            <% } else { %>
              <%= visitor.permissions.map(labelOf).join('、') %>
            <% } %>
          </span>
        </div>
        <div class="post-actions">
          <mdui-button
            variant="text"
            data-action="delete-visitor"
            data-email="<%= visitor.email %>"
          >🗑️ 删除</mdui-button>
        </div>
      </div>
    <% }); %>
  <% } %>
</mdui-card>

<mdui-card class="card">
  <h2>待审核申请</h2>
  <% if (pending.length === 0) { %>
    <div class="empty-state">暂无待审核的申请</div>
  <% } else { %>
    <% pending.forEach((item) => { %>
      <div class="post-item" data-email="<%= item.email %>">
        <div class="post-info">
          <h3><%= item.name || item.email %></h3>
          <span><%= item.email %> · <%= formatDateTime(item.createdAt) %></span>
          <div class="perm-group">
            <% permissions.forEach((perm) => { %>
              <mdui-checkbox class="pending-perm" data-email="<%= item.email %>" value="<%= perm %>"><%= labelOf(perm) %></mdui-checkbox>
            <% }); %>
          </div>
        </div>
        <div class="post-actions">
          <mdui-button
            variant="filled"
            data-action="approve-visitor"
            data-email="<%= item.email %>"
          >✅ 通过</mdui-button>
          <mdui-button
            variant="text"
            data-action="reject-visitor"
            data-email="<%= item.email %>"
          >🚫 拒绝</mdui-button>
        </div>
      </div>
    <% }); %>
  <% } %>
</mdui-card>
