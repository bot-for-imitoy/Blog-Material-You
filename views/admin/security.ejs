<%
  /**
   * admin/security.ejs — two-factor authentication + password change.
   *
   * Three TOTP states are represented:
   *   已启用   enabled && !hasPending
   *   待验证   hasPending (a secret was generated but not yet confirmed)
   *   未启用   !enabled && !hasPending
   *
   * SECURITY: only the PENDING secret reaches this template. Once 2FA is
   * active the secret is never rendered, so a compromised admin session cannot
   * exfiltrate the second factor.
   *
   * The setup panel is always in the markup (hidden while there is no pending
   * secret) so `data-action="totp-start"` can reveal it by filling in the
   * values returned by the API — no DOM construction in the client.
   */
  const enabled = totp.enabled;
  const hasPending = totp.hasPending;
%>
<div class="page-header">
  <h1>🔐 安全设置</h1>
</div>

<div id="security-error" class="form-error" role="alert" hidden></div>

<% if (enabled) { %>
  <section class="card">
    <h2>🔐 两步验证 <span class="status-badge status-enabled">✅ 已启用</span></h2>
    <p class="desc">两步验证已开启。每次登录时需要输入密码和身份验证器中的验证码。</p>
    <p class="warn"><%= t('admin_totp_save_warning') %></p>
    <div class="form-actions">
      <button type="button" class="btn btn-outline" data-action="totp-regenerate">🔄 重新生成密钥</button>
      <button type="button" class="btn btn-danger" data-action="totp-disable">🚫 禁用</button>
    </div>
  </section>
<% } else if (!hasPending) { %>
  <section class="card">
    <h2>🔐 两步验证 <span class="status-badge status-disabled">未启用</span></h2>
    <p class="desc">开启两步验证后，登录时需要额外输入身份验证器中的验证码，增强账户安全性。</p>
    <div class="form-actions">
      <button type="button" class="btn btn-primary" data-action="totp-start">🔐 启用</button>
    </div>
  </section>
<% } %>

<section class="card" id="totp-setup-card" <%= hasPending ? '' : 'hidden' %>>
  <h2>🔐 设置两步验证 <span class="status-badge status-pending">待验证</span></h2>
  <p class="desc">使用身份验证器应用（如 Google Authenticator、Authy）扫描此二维码或手动输入密钥，然后填写 6 位验证码完成绑定。</p>

  <%# The image is only shown when the server hands over a real `data:image`
      URI; an `otpauth://` URI is not an image, so the secret below stays the
      usable fallback. /js/admin.js hides the image in that case. %>
  <img id="totp-qr" class="totp-qr" alt="TOTP 二维码" data-uri="<%= totp.provisioningUri %>" hidden>
  <div class="totp-secret-display" id="totp-secret"><%= totp.secret %></div>
  <div class="form-group">
    <span class="field-label">手动输入密钥</span>
    <code id="totp-uri" class="totp-uri"><%= totp.provisioningUri %></code>
  </div>

  <form id="totp-form">
    <div class="form-group">
      <label for="totp-verify-code">验证码</label>
      <input
        type="text"
        id="totp-verify-code"
        name="code"
        placeholder="000000"
        maxlength="6"
        inputmode="numeric"
        autocomplete="one-time-code"
      >
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="totp-verify">✅ 验证并启用</button>
      <button type="button" class="btn btn-outline" data-action="totp-cancel">取消</button>
    </div>
  </form>
</section>

<section class="card">
  <h2>🔑 修改密码</h2>
  <div id="cp-error" class="form-error" role="alert" hidden></div>
  <form id="password-form">
    <div class="form-row">
      <div class="form-group">
        <label for="cp-old">当前密码</label>
        <input type="password" id="cp-old" name="oldPassword" placeholder="输入当前密码" autocomplete="current-password">
      </div>
      <div class="form-group">
        <label for="cp-user">新用户名（可选）</label>
        <input type="text" id="cp-user" name="newUser" placeholder="留空则不修改" autocomplete="username">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="cp-new">新密码</label>
        <input type="password" id="cp-new" name="newPassword" placeholder="至少6位" autocomplete="new-password">
        <p class="field-help">至少 6 位</p>
      </div>
      <div class="form-group">
        <label for="cp-new2">确认新密码</label>
        <input type="password" id="cp-new2" name="newPassword2" placeholder="再次输入新密码" autocomplete="new-password">
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-action="change-password">💾 保存更改</button>
    </div>
  </form>
</section>
