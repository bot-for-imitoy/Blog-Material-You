<%
  /**
   * admin/pages.ejs — standalone page list (about, talks, …).
   * Editing an existing page goes to /admin/pages/:slug/edit/; a new page uses
   * a free-form slug, so both entry points land on the same editor template.
   */
%>
<div class="page-header">
  <h1>📑 页面</h1>
  <a class="btn btn-primary" href="/admin/pages/new/" data-action="new-page">➕ 新建页面</a>
</div>

<% if (pages.length === 0) { %>
  <p class="empty-state">暂无页面</p>
<% } else { %>
  <section class="card">
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>标题</th>
            <th>标识</th>
            <th class="col-actions">操作</th>
          </tr>
        </thead>
        <tbody>
          <% pages.forEach((page) => { %>
            <tr data-slug="<%= page.slug %>">
              <td><%= page.title || page.slug %></td>
              <td><code><%= page.slug %></code></td>
              <td class="col-actions">
                <a
                  class="btn btn-outline"
                  href="/admin/pages/<%= encodeURIComponent(page.slug) %>/edit/"
                  data-action="edit-page"
                  data-slug="<%= page.slug %>"
                >✏️ 编辑</a>
                <button
                  type="button"
                  class="btn btn-danger"
                  data-action="delete-page"
                  data-slug="<%= page.slug %>"
                  data-title="<%= page.title || page.slug %>"
                >🗑️ 删除</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
