<%
  /**
   * admin/imghost.ejs — image host configuration (SFTP or S3/MinIO).
   *
   * `config` is already masked by the route (secret_key → '********'), so the
   * stored secret never reaches the browser. An empty or masked secret_key on
   * save preserves the stored value.
   *
   * The two provider field groups are <fieldset>s marked with data-provider so
   * /js/admin.js can show only the group matching #provider.
   */
%>
<div class="page-header">
  <h1>🖼️ 图床设置</h1>
  <span id="status-badge" class="status-badge <%= config.enabled ? 'status-enabled' : 'status-disabled' %>">
    <%= config.enabled ? '已启用' : '未启用' %>
  </span>
</div>

<div id="imghost-error" class="form-error" role="alert" hidden></div>

<form id="imghost-form">
  <section class="card">
    <h2>启用状态</h2>
    <div class="form-row">
      <div class="form-group form-check">
        <input type="checkbox" id="enabled" name="enabled" <%= config.enabled ? 'checked' : '' %>>
        <label for="enabled">启用图床</label>
      </div>
      <div class="form-group">
        <label for="provider">存储方式</label>
        <select id="provider" name="provider">
          <option value="sftp" <%= config.provider === 'sftp' ? 'selected' : '' %>>SFTP</option>
          <option value="s3" <%= config.provider === 's3' ? 'selected' : '' %>>S3 / MinIO</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="filename_template">文件名模板</label>
      <input
        type="text"
        id="filename_template"
        name="filename_template"
        placeholder="{yy}-{mm}-{dd}.{file_extension}"
        value="<%= config.filename_template %>"
      >
    </div>
  </section>

  <fieldset class="card" id="s3-card" data-provider="s3" <%= config.provider === 's3' ? '' : 'hidden' %>>
    <legend>S3 / MinIO 配置</legend>
    <div class="form-row">
      <div class="form-group">
        <label for="s3_endpoint">Endpoint</label>
        <input type="text" id="s3_endpoint" name="endpoint" placeholder="http://minio:9000 或 https://s3.amazonaws.com" value="<%= config.endpoint %>">
      </div>
      <div class="form-group">
        <label for="s3_bucket">Bucket</label>
        <input type="text" id="s3_bucket" name="bucket" placeholder="blog-images" value="<%= config.bucket %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="s3_access_key">Access Key</label>
        <input type="text" id="s3_access_key" name="access_key" value="<%= config.access_key %>">
      </div>
      <div class="form-group">
        <label for="s3_secret_key">Secret Key</label>
        <input
          type="password"
          id="s3_secret_key"
          name="secret_key"
          placeholder="留空或填 ******** 表示保持不变"
          value="<%= config.secret_key %>"
        >
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="s3_region">Region</label>
        <input type="text" id="s3_region" name="region" placeholder="us-east-1" value="<%= config.region %>">
      </div>
      <div class="form-group">
        <label for="s3_prefix">前缀</label>
        <input type="text" id="s3_prefix" name="prefix" placeholder="blog" value="<%= config.prefix %>">
      </div>
      <div class="form-group">
        <label for="s3_public_url_base">公开访问地址</label>
        <input type="text" id="s3_public_url_base" name="public_url_base" placeholder="https://cdn.example.com/blog" value="<%= config.public_url_base %>">
      </div>
    </div>

    <h3 class="section-title">TLS / 双向认证（mTLS，可选）</h3>
    <div class="form-row">
      <div class="form-group">
        <label for="s3_ssl_ca">CA 证书路径</label>
        <input type="text" id="s3_ssl_ca" name="ssl_ca" placeholder="/certs/ca.pem" value="<%= config.ssl_ca %>">
      </div>
      <div class="form-group">
        <label for="s3_ssl_cert">客户端证书路径</label>
        <input type="text" id="s3_ssl_cert" name="ssl_cert" placeholder="/certs/client.crt" value="<%= config.ssl_cert %>">
      </div>
      <div class="form-group">
        <label for="s3_ssl_key">客户端私钥路径</label>
        <input type="text" id="s3_ssl_key" name="ssl_key" placeholder="/certs/client.key" value="<%= config.ssl_key %>">
      </div>
    </div>
    <div class="form-group form-check">
      <input type="checkbox" id="s3_insecure" name="insecure" <%= config.insecure ? 'checked' : '' %>>
      <label for="s3_insecure">跳过 TLS 验证（自签名证书）</label>
    </div>
  </fieldset>

  <fieldset class="card" id="sftp-card" data-provider="sftp" <%= config.provider === 'sftp' ? '' : 'hidden' %>>
    <legend>SFTP 配置</legend>
    <div class="form-row">
      <div class="form-group">
        <label for="sftp_host">主机</label>
        <input type="text" id="sftp_host" name="host" placeholder="example.com" value="<%= config.host %>">
      </div>
      <div class="form-group">
        <label for="sftp_port">端口</label>
        <input type="number" id="sftp_port" name="port" value="<%= config.port %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="sftp_username">用户名</label>
        <input type="text" id="sftp_username" name="username" value="<%= config.username %>">
      </div>
      <div class="form-group">
        <label for="sftp_ssh_key_path">私钥路径</label>
        <input type="text" id="sftp_ssh_key_path" name="ssh_key_path" placeholder="/app/keys/id_rsa" value="<%= config.ssh_key_path %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="sftp_remote_dir">远程目录</label>
        <input type="text" id="sftp_remote_dir" name="remote_dir" placeholder="/var/www/images" value="<%= config.remote_dir %>">
      </div>
      <div class="form-group">
        <label for="sftp_public_url_base">公开访问地址</label>
        <input type="text" id="sftp_public_url_base" name="public_url_base" placeholder="https://images.example.com" value="<%= config.public_url_base %>">
      </div>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" id="save-btn" class="btn btn-primary" data-action="save-imghost">💾 保存配置</button>
    <button type="button" id="test-btn" class="btn btn-outline" data-action="test-imghost">🔌 测试连接</button>
  </div>
</form>

<div id="result-box" class="result-box" hidden></div>

<section class="card">
  <h2>测试上传</h2>
  <form id="upload-form">
    <div class="file-row">
      <input type="file" id="upload-file" accept="image/*">
      <div class="form-group">
        <label for="upload-name">文件名（可选）</label>
        <input type="text" id="upload-name" name="filename" placeholder="image.png">
      </div>
      <button type="submit" id="upload-btn" class="btn btn-primary" data-action="upload-imghost">⬆️ 上传</button>
    </div>
  </form>
  <div id="upload-result" class="result-box" hidden></div>
</section>
