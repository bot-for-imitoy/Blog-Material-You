# Blog Material You — .dockerignore

# Dependencies and build caches (reinstalled inside the image)
node_modules/
.npm-cache/
npm-debug.log*

# Runtime data and secrets
blog/data/
.env
*.pid

# Vendored front-end libraries — regenerated by `node scripts/sync-assets.mjs`
blog/public/vendor/

# Local deployment files that may contain real credentials
docker-compose.local.yml
certs.local/

# Git / editor / OS
.git/
.gitignore
.dockerignore
.DS_Store
Thumbs.db

# Local scratch files
.scratch_*
project_dump.txt

# The previous OpenResty implementation (kept in git history only)
backend/logs/
backend/tmp/
backend/data/
backend/nginx.pid
