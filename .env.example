# Blog Material You — 环境变量配置
# 复制此文件为 .env 并按需修改：
#   cp .env.example .env
#
# 本项目是「本地文件存储」的博客（类似 Hexo）：没有数据库，所有内容都是
# blog/ 下的 Markdown 文件，运行状态是 blog/data/ 下的 JSON 文件。
#
# ⚠️ 站点配置（名称、简介、头像、导航菜单、功能开关、界面文案等）不在这里，
#    而在仓库根目录的 _config.yml 中。本文件只放「因部署而异 / 属于机密」的
#    设置：端口、会话密钥、管理员初始账号、各服务的密钥等。

# ===== 服务 =====
# 监听端口与地址（默认 30999 / 0.0.0.0）
# BMY_PORT=30999
# BMY_HOST=0.0.0.0

# 个人名片页 /profile/ 的独立端口（默认 31000）。
# 主页运行在自己的端口上，不与博客共用：反向代理可以把一个域名指向博客、
# 另一个域名指向这个端口，两者共享同一份内容、静态资源与数据目录。
# BMY_PROFILE_PORT=31000

# 站点对外地址。用于 canonical 链接、sitemap.xml 与 rss.xml。
# 这是唯一会被环境变量覆盖的站点配置项：显式设置后优先于 _config.yml 的 url，
# 便于容器在不改动受版本控制文件的前提下改指向。
# 例如 https://blog.example.com
# BMY_SITE_URL=

# 站点配置文件路径（默认 ./_config.yml）
# BMY_CONFIG_FILE=/path/to/other-config.yml

# 放在反向代理后面时设为 1，这样限流会按 X-Forwarded-For 的真实客户端 IP 计数
# BMY_TRUST_PROXY=1

# 单次请求体上限（MB），用于后台导入备份（默认 100）
# BMY_MAX_UPLOAD_MB=100

# ===== 管理员账号 =====
# BMY_ADMIN_PASS 仅在「尚未初始化管理员」时用于创建账号（也可以直接访问
# /admin/setup/ 在网页上创建）；它不会覆盖你在后台改过的密码。
# BMY_ADMIN_USER=admin
# BMY_ADMIN_PASS=

# 忘记密码？这里刻意不提供「强制重置」的环境变量——重置必须是显式命令：
#   npm run passwd-reset                  交互式设置新密码
#   npm run passwd-reset -- --clear       删除账号，再用 /admin/setup/ 重建
# Docker 内：docker compose exec blog npm run passwd-reset -- --clear

# 会话 Token 的 HMAC 签名密钥。
# 留空时程序会在首次启动生成随机密钥并写入 blog/data/secret.json（推荐本地使用）。
# 生产环境建议显式设置一个随机值：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# BMY_SESSION_SECRET=

# ===== 目录（一般不需要修改）=====
# 内容与静态资源根目录（默认 ./blog）
# BMY_BLOG_DIR=
# 运行状态目录（默认 $BMY_BLOG_DIR/data）
# BMY_DATA_DIR=
# 静态资源目录（默认 $BMY_BLOG_DIR/public）
# BMY_PUBLIC_DIR=
# 模板目录（默认 ./views）
# BMY_VIEWS_DIR=

# ===== 图床（可选）=====
# 不配置时，上传的图片直接存到 blog/public/avatars 与 blog/public/uploads。
# 设置 BMY_IMGHOST_PROVIDER=s3 并填写下面四项即可启用 S3 兼容对象存储
# （MinIO / AWS S3 / Cloudflare R2 等）。

# 图床提供方：sftp | s3
# BMY_IMGHOST_PROVIDER=

# 也可以只填下面四项，程序会自动启用 S3：
# BMY_S3_ENDPOINT=http://minio:9000
# BMY_S3_BUCKET=blog-images
# BMY_S3_ACCESS_KEY=minioadmin
# BMY_S3_SECRET_KEY=minioadmin

# 区域（AWS 需要，MinIO 通常可省略；默认 us-east-1）
# BMY_S3_REGION=us-east-1

# 桶内对象前缀（可选，例如 blog）
# BMY_S3_PREFIX=

# 图片公开访问的 URL 基址（可选，默认使用 $BMY_S3_ENDPOINT/$BMY_S3_BUCKET）
# 使用 CDN 或自定义域名时设置，例如 https://cdn.example.com
# BMY_S3_PUBLIC_URL_BASE=

# 跳过 TLS 证书校验（自签名证书时设为 1）
# BMY_S3_INSECURE=0

# ===== S3 TLS / 双向认证（mTLS，可选）=====
# 路径为容器内路径，需要把证书挂载进容器（如 /certs）。
# 注意：双向 TLS 需要「证书 + 私钥合并成一个文件」，因此
# BMY_S3_SSL_CERT 与 BMY_S3_SSL_KEY 通常指向同一个文件。

# CA 证书路径（校验服务端证书）
# BMY_S3_SSL_CA=/certs/ca.pem
# 客户端证书 / 私钥（双向 TLS）
# BMY_S3_SSL_CERT=/certs/client-bundle.pem
# BMY_S3_SSL_KEY=/certs/client-bundle.pem
