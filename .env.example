# Blog Material You — 环境变量配置
# 复制此文件为 .env 并修改值
# cp .env.example .env

# 管理员用户名（默认：admin）
# BMY_ADMIN_USER=admin

# 管理员密码（默认：bmy2025）
# BMY_ADMIN_PASS=bmy2025

# Session Token HMAC 签名密钥（默认：bmy-session-secret-k8x9m2p4v6）
# 生产环境请使用随机字符串：python3 -c "import secrets; print(secrets.token_hex(32))"
# BMY_SESSION_SECRET=your-random-secret-here

# ===== 数据库连接（默认使用本地 Unix Socket / 嵌入式 MariaDB）=====
# 指定新的数据库时，取消注释并按需修改以下变量。
# 注意：nginx 需要读取这些环境变量，修改后需重启服务。

# 数据库名（默认：blogyou）
# BMY_DB_NAME=blogyou

# 数据库用户（默认：blogyou）
# BMY_DB_USER=blogyou

# 数据库密码（默认：blog-db-pass-2025）
# BMY_DB_PASS=blog-db-pass-2025

# 数据库 Unix Socket 路径（默认：$BMY_BLOG_DIR/data/mysql/mysql.sock）
# BMY_DB_SOCKET=/path/to/mysql.sock

# 使用 TCP 连接远程/新数据库时设置主机和端口（设置了 BMY_DB_HOST 后将忽略 Socket）
# 在 Docker 中设置 BMY_DB_HOST 后，容器将不再启动内置 MariaDB（分布式部署）
# BMY_DB_HOST=127.0.0.1
# BMY_DB_PORT=3306

# ===== S3 图床（MinIO / 兼容 S3 的对象存储）=====
# 设置以下变量即可启用 S3 图床（分布式部署时推荐，图片与博客实例解耦）。
# 仅需 endpoint/bucket/access/secret 四个变量即可自动启用；也可配合
# BMY_IMGHOST_PROVIDER=s3 显式指定。

# 图床提供方：sftp（默认）| s3（设置后启用图床）
# BMY_IMGHOST_PROVIDER=s3

# S3 服务地址，例如 http://minio:9000 或 https://s3.amazonaws.com
# BMY_S3_ENDPOINT=http://minio:9000

# 存储桶名称
# BMY_S3_BUCKET=blog-images

# 访问密钥
# BMY_S3_ACCESS_KEY=minioadmin

# 秘密密钥
# BMY_S3_SECRET_KEY=minioadmin

# 区域（可选，AWS 需要，MinIO 通常可省略）
# BMY_S3_REGION=us-east-1

# 桶内对象前缀（可选，例如 blog）
# BMY_S3_PREFIX=blog

# 图片公开访问的 URL 基址（可选，默认使用 $BMY_S3_ENDPOINT/$BMY_S3_BUCKET）
# 使用 CDN 或自定义域名时设置，例如 https://cdn.example.com/blog
# BMY_S3_PUBLIC_URL_BASE=https://cdn.example.com/blog

# 跳过 TLS 证书校验（自签名证书时设为 1）
# BMY_S3_INSECURE=0
