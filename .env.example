# Blog Material You — 环境变量配置
# 复制此文件为 .env 并修改值
# cp .env.example .env

# 管理员用户名（默认：admin）
# BMY_ADMIN_USER=admin

# 管理员密码（默认：bmy2025）
# BMY_ADMIN_PASS=bmy2025

# Session Token HMAC 签名密钥（默认：bmy-session-secret-k8x9m2p4v6）
# 生产环境请使用随机字符串：python3 -c "import secrets; print(secrets.token_hex(32))"
# BMY_SESSION_SECRET=your-random-secret-here

# ===== 数据库连接（本地直跑默认使用 Unix Socket；Docker 镜像不内置数据库）=====
# 指定新的数据库时，取消注释并按需修改以下变量。
# 注意：nginx 需要读取这些环境变量，修改后需重启服务。
# Docker：镜像已不内置 MariaDB，容器必须通过 BMY_DB_URL（或 BMY_DB_HOST）
# 连接外部数据库（如宿主机上的 MariaDB/MySQL），docker-compose.yml 默认用
# mariadb:// URL 指向 host.docker.internal:3306 的宿主机数据库。

# 数据库名（默认：blogyou）
# BMY_DB_NAME=blogyou

# 数据库用户（默认：blogyou）
# BMY_DB_USER=blogyou

# 数据库密码（默认：blog-db-pass-2025）
# BMY_DB_PASS=blog-db-pass-2025

# 数据库 Unix Socket 路径（默认：$BMY_BLOG_DIR/data/mysql/mysql.sock）
# BMY_DB_SOCKET=/path/to/mysql.sock

# 使用 TCP 连接远程/新数据库时设置主机和端口（设置了 BMY_DB_HOST 后将忽略 Socket）
# Docker 镜像已不内置 MariaDB：容器必须通过 BMY_DB_URL 或 BMY_DB_HOST 连接
# 外部数据库（如宿主机上的 MariaDB/MySQL）。
# BMY_DB_HOST=127.0.0.1
# BMY_DB_PORT=3306

# ===== 连接串形式（推荐，支持 SSL / 双向 TLS）=====
# 使用 mariadb:// 或 mysql:// 连接串，可方便地填入 SSL 证书（优先级高于
# 上面的 BMY_DB_* 单项变量）。查询参数均为可选：
#   ssl_ca=/path/ca.pem           校验服务端证书的 CA 包
#   ssl_cert=/path/client.crt    客户端证书（双向 TLS）
#   ssl_key=/path/client.key     客户端私钥（双向 TLS）
#   ssl_verify=0|1               是否校验服务端证书（默认 1）
#   ssl_server_name=host         TLS SNI / 校验主机名
# BMY_DB_URL=mariadb://blogyou:your-password@db.example.com:3306/blogyou?ssl_ca=/certs/ca.pem&ssl_cert=/certs/client.crt&ssl_key=/certs/client.key

# ===== S3 图床（MinIO / 兼容 S3 的对象存储）=====
# 设置以下变量即可启用 S3 图床（分布式部署时推荐，图片与博客实例解耦）。
# 仅需 endpoint/bucket/access/secret 四个变量即可自动启用；也可配合
# BMY_IMGHOST_PROVIDER=s3 显式指定。

# 图床提供方：sftp（默认）| s3（设置后启用图床）
# BMY_IMGHOST_PROVIDER=s3

# S3 服务地址，例如 http://minio:9000 或 https://s3.amazonaws.com
# BMY_S3_ENDPOINT=http://minio:9000

# 存储桶名称
# BMY_S3_BUCKET=blog-images

# 访问密钥
# BMY_S3_ACCESS_KEY=minioadmin

# 秘密密钥
# BMY_S3_SECRET_KEY=minioadmin

# 区域（可选，AWS 需要，MinIO 通常可省略）
# BMY_S3_REGION=us-east-1

# 桶内对象前缀（可选，例如 blog）
# BMY_S3_PREFIX=blog

# 图片公开访问的 URL 基址（可选，默认使用 $BMY_S3_ENDPOINT/$BMY_S3_BUCKET）
# 使用 CDN 或自定义域名时设置，例如 https://cdn.example.com/blog
# BMY_S3_PUBLIC_URL_BASE=https://cdn.example.com/blog

# 跳过 TLS 证书校验（自签名证书时设为 1）
# BMY_S3_INSECURE=0

# ===== S3 TLS / 双向认证（mTLS，可选）=====
# 证书文件路径为容器内的路径，需将证书挂载到容器中（如 /certs）。
# 客户端证书与私钥需同时提供；CA 用于校验服务端证书。

# CA 证书路径（校验服务端证书）
# BMY_S3_SSL_CA=/certs/ca.pem

# 客户端证书路径（双向 TLS）
# BMY_S3_SSL_CERT=/certs/client.crt

# 客户端私钥路径（双向 TLS）
# BMY_S3_SSL_KEY=/certs/client.key
