# Blog Material You — 环境变量配置
# 复制此文件为 .env 并修改值
# cp .env.example .env

# 管理员用户名（默认：admin）
# BMY_ADMIN_USER=admin

# 管理员密码（默认：bmy2025）
# BMY_ADMIN_PASS=bmy2025

# Session Token HMAC 签名密钥（默认：bmy-session-secret-k8x9m2p4v6）
# 生产环境请使用随机字符串：python3 -c "import secrets; print(secrets.token_hex(32))"
# BMY_SESSION_SECRET=your-random-secret-here

# ===== 数据库连接（默认使用本地 Unix Socket）=====
# 指定新的数据库时，取消注释并按需修改以下变量。
# 注意：nginx 需要读取这些环境变量，修改后需重启服务。

# 数据库名（默认：blogyou）
# BMY_DB_NAME=blogyou

# 数据库用户（默认：blogyou）
# BMY_DB_USER=blogyou

# 数据库密码（默认：blog-db-pass-2025）
# BMY_DB_PASS=blog-db-pass-2025

# 数据库 Unix Socket 路径（默认：$BMY_BLOG_DIR/data/mysql/mysql.sock）
# BMY_DB_SOCKET=/path/to/mysql.sock

# 使用 TCP 连接远程/新数据库时设置主机和端口（设置了 BMY_DB_HOST 后将忽略 Socket）
# BMY_DB_HOST=127.0.0.1
# BMY_DB_PORT=3306
